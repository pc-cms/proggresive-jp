  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "command_id": {
            "type": "string",
            "maxLength": 128,
            "title": "Command Id"
          },
          "op": {
            "type": "string",
            "maxLength": 80,
            "title": "Op"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "operator_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Id"
          },
          "sequence": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "command_id",
          "op",
          "payload"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lease": {
        "properties": {
          "operator_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 16,
            "title": "Operator Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operator_id"
        ],
        "title": "Lease"
      },
      "Login": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "title": "Name"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "password"
        ],
        "title": "Login"
      },
      "Metadata": {
        "properties": {
          "winner_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Winner Name"
          },
          "cms_player_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Cms Player Id"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Metadata"
      },
      "Pair": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 128,
            "title": "Code"
          },
